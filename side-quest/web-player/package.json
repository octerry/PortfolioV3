{
  "name": "web-player",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev",
    "dev:socket": "tsx watch server/index.ts",
    "dev": "concurrently -n next, socket \"npm:dev:next\" \"npm:dev:socket\"",
    "build": "next build",
    "start:next": "next start",
    "start:socket": "tsx server/index.ts",
    "start": "concurrently -n next, socket \"npm:start:next\" \"npm:start:socket\"",
    "lint": "eslint"
  },
  "dependencies": {
    "http": "^0.0.1-security",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
